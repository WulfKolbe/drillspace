{
  "name": "pdfdrill playground",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",

  // Without an SSH server in the container, `gh codespace ssh` and
  // `gh codespace logs` both fail outright, so a codespace that misbehaves
  // cannot be inspected from outside at all — no logs, no shell, no way to
  // see whether a lifecycle hook ran. This feature is what makes the
  // playground debuggable remotely.
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },

  "onCreateCommand": "bash .devcontainer/onCreate.sh",
  "waitFor": "onCreateCommand",

  // postAttachCommand ONLY — deliberately not postStartCommand.
  //
  // Port 8787 is set to onAutoForward "openBrowser", and VS Code fires that
  // when it detects a port opening WHILE ATTACHED. A bridge started at
  // container start (postStartCommand) is already listening before the editor
  // connects, so there is nothing to detect and the browser never opens — the
  // visitor is left to find the Ports panel on their own.
  "postAttachCommand": "bash .devcontainer/start-drillui.sh",

  "hostRequirements": {
    "storage": "32gb"
  },

  "remoteUser": "vscode",

  "remoteEnv": {
    "PATH": "/home/vscode/.bun/bin:/home/vscode/.local/bin:${containerEnv:PATH}",
    "PYTHONPATH": "${containerWorkspaceFolder}/src",
    "BUN_INSTALL": "/home/vscode/.bun",
    "PDFDRILL_PLAYGROUND": "1",
    "PDFDRILL_NO_PREFLIGHT": "1"
  },

  "forwardPorts": [8787, 8080, 10000],

  "portsAttributes": {
    // "notify", NOT "openBrowser" — and no "visibility" key. Both were tried
    // and measured, so do not reinstate them without new evidence:
    //
    //   - "visibility": "public" reaches the merged devcontainer config but is
    //     never applied. Verified on a clean attach, with the bridge opening
    //     the port while VS Code was watching: the port stayed private and an
    //     unauthenticated fetch still got GitHub's sign-in page. Codespaces
    //     does not honour it here. Setting it with `gh codespace ports
    //     visibility` works but does not survive a stop/start, and the
    //     container cannot set it for itself (no gh, and the built-in token
    //     has no codespace scope).
    //
    //   - "openBrowser" opens the forwarded URL in a plain tab, which for a
    //     private port means GitHub's pf-signin hand-off — and that hand-off
    //     failed repeatedly in a real browser, landing on a forwarding error
    //     instead of drillui.
    //
    // "notify" raises a toast carrying VS Code's own authenticated open path
    // — the same route as the Ports panel's "Open in Browser", which is the
    // one thing observed to work every time. One click, and it comes to the
    // visitor instead of being buried in a panel they have to know about.
    "8787": {
      "label": "drillui (ask-the-document terminal)",
      "onAutoForward": "notify"
    },
    "8080": {
      "label": "TiddlyWiki (bun)",
      "onAutoForward": "silent"
    },
    "10000": {
      "label": "drillui artifacts (static)",
      "onAutoForward": "silent"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "oven.bun-vscode",
        "James-Yu.latex-workshop"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "workbench.startupEditor": "none"
      }
    }
  }
}
